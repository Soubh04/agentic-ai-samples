# Copy to .env (git-ignored) and fill in YOUR values. Never commit real values.
# Set the variables for the clouds you want to try. A cloud with missing variables is skipped.

# Azure: a Microsoft Foundry / Azure OpenAI resource with a chat model deployed
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-model-deployment-name>

# AWS: Amazon Bedrock in this region
AWS_REGION=<your-aws-region>
BEDROCK_MODEL_ID=<your-bedrock-model-id-or-inference-profile-id>

# Google Cloud: Gemini Enterprise Agent Platform (formerly Vertex AI)
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=<your-gcp-location>
GEMINI_MODEL=<your-gemini-model-id>
